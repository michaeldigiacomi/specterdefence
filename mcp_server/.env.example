# MCP Server Configuration
# Copy these variables into your MCP client config (see docs/MCP.md).
# Do NOT put real credentials in this file or commit them.

# Base URL of the SpecterDefence backend API
SPECTER_BASE_URL=http://localhost:8000

# SpecterDefence credentials (same account you use on the dashboard).
# Recommend a dedicated non-admin user for agent access.
SPECTER_USERNAME=admin
SPECTER_PASSWORD=

# Request timeout in seconds
SPECTER_TIMEOUT=30